# Database
DATABASE_URL=postgresql://pratibha:pratibha@localhost:5432/pratibha

# How long one request-path transaction may run. Every RLS read lives inside
# withTenant(), and queries in an interactive transaction share one connection,
# so a page assembling many reads pays them serially. Defaults to 20000; live
# runs 30000 because the overview endpoint has been measured at ~15s.
PRISMA_TRANSACTION_TIMEOUT_MS=30000
# How long to wait for a free connection before failing fast. Defaults to 5000.
PRISMA_TRANSACTION_MAX_WAIT_MS=5000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# AI / speech
ANTHROPIC_API_KEY=
SARVAM_API_KEY=

# Telephony
PLIVO_AUTH_TOKEN=
PRATIBHA_NUMBER=+918031705255

# Email
RESEND_API_KEY=

# Worker
PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_WS_URL=ws://localhost:8091/pratibha/stream
OS_API_BASE=http://localhost:3000
OS_SERVICE_TOKEN=worker-service-token
OS_HMAC_SECRET=worker-hmac-secret
