# Copy to .env.docker and fill in. Never commit the filled-in copy.
#
#   cp .env.docker.example .env.docker
#
# Only the first block is needed to log in and click around. Everything below
# it buys a specific capability, and the app states plainly what is missing
# rather than failing obscurely.

# --- Auth. These three must agree with docker-compose.dev.yml. ---------------
# Local dev values, safe to share. The anon key is a JWT signed with the secret
# below; both are Supabase's published defaults for local development and must
# never be reused anywhere reachable from the internet.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_URL=http://auth:9999
NEXT_PUBLIC_SUPABASE_URL=http://localhost:9999
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# --- URLs the containers use to reach each other -----------------------------
PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_WS_URL=ws://localhost:8091/pratibha/stream
OS_API_BASE=http://web:3000

# --- Run without telephony or speech vendors ---------------------------------
# Mock STT and TTS, so the conversation loop can be exercised with no Sarvam or
# Plivo credentials at all. Turn this off only with real keys in place.
MOCK_MODE=true
ALLOW_INCOMPLETE_CONFIG=true

# --- The model. Needed for CV screening and for interviews. ------------------
# Ask Deepak for a key. Leave ANTHROPIC_BASE_URL unset to talk to Anthropic
# directly; set it to https://api.moonshot.ai/anthropic for Kimi, in which case
# the key must be Moonshot's.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_ANALYSIS_MODEL=claude-haiku-4-5

# --- Only for real calls. Leave blank while MOCK_MODE=true. ------------------
SARVAM_API_KEY=
PLIVO_AUTH_TOKEN=
PLIVO_VERIFY_SIGNATURE=false

# --- Email -------------------------------------------------------------------
# Local mail goes to Mailpit at http://localhost:8025 and is never delivered.
# Leave RESEND_API_KEY blank unless you specifically need to test real sending.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
RESEND_API_KEY=

# --- Local convenience --------------------------------------------------------
VERIFY_CALLER_EMAIL=false
OS_SERVICE_TOKEN=local-service-token
OS_HMAC_SECRET=local-hmac-secret
