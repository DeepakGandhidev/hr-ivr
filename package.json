{
  "name": "pratibha",
  "version": "2.0.0",
  "private": true,
  "description": "Pratibha v2 \u2014 multi-tenant inbound hiring agent",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/web\" \"npm run dev -w apps/worker\"",
    "build": "npm run build -w apps/web && npm run build -w apps/worker",
    "start": "npm run start -w apps/worker",
    "test": "npm run test --workspaces --if-present",
    "test:authz": "npm run test:authz -w apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run db:generate -w packages/prisma",
    "db:migrate": "npm run db:migrate -w packages/prisma",
    "db:seed": "npm run db:seed -w packages/prisma",
    "db:studio": "npm run db:studio -w packages/prisma",
    "db:mock": "node scripts/seed-mock-data.js",
    "db:reset": "npm run db:migrate && npm run db:seed && npm run db:mock && npm run db:mock:auth",
    "db:mock:auth": "node scripts/seed-mock-auth.js",
    "test:isolation": "node scripts/check-isolation.mjs",
    "db:test-candidate": "node scripts/add-test-candidate.js",
    "db:reset-production": "node scripts/reset-production.mjs",
    "dev:up": "./scripts/dev-up.sh",
    "dev:down": "./scripts/dev-down.sh",
    "dev:status": "./scripts/dev-up.sh --status"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
