{
  "name": "@pratibha/prisma",
  "version": "2.0.0",
  "description": "Prisma schema and client shared by Pratibha web and worker",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.js",
