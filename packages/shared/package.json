  "dependencies": {
    "zod": "^3.23.8",
    "nodemailer": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.5.4",
    "@types/nodemailer": "^6.4.16"
  }
}
