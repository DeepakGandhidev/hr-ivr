DATABASE_URL=postgresql://pratibha:pratibha@localhost:5432/pratibha
ANTHROPIC_API_KEY=
SARVAM_API_KEY=
PLIVO_AUTH_TOKEN=
PRATIBHA_NUMBER=+918031705255
PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_WS_URL=ws://localhost:8091/pratibha/stream
OS_API_BASE=http://localhost:3000
OS_SERVICE_TOKEN=worker-service-token
OS_HMAC_SECRET=worker-hmac-secret
MOCK_MODE=false
LOG_LEVEL=info

# --- Email ingestion (IMAP) -------------------------------------------------
# Encrypts mailbox passwords at rest. Generate with: openssl rand -hex 32
# Must be identical in the web app and the worker, or saved mailboxes cannot
# be opened by the poller.
EMAIL_SECRET_KEY=
# How often to sweep every connected mailbox. IMAP IDLE delivers new mail in
# seconds; this interval is the safety net for dropped IDLE sockets.
EMAIL_POLL_INTERVAL_MS=600000

# Interviews are open to anyone whose email matches an application. Set true to
# require a recruiter to screen, shortlist and approve a candidate first.
REQUIRE_SHORTLIST_APPROVAL=false

# A live call cannot wait on the SDK's 10-minute default: a hung request holds
# the turn and the line goes silent while the candidate keeps talking.
ANTHROPIC_TIMEOUT_MS=12000
ANTHROPIC_MAX_RETRIES=1

# Caller recognition: trust the number the candidate applied with.
#
# On by default, the agent recognises the caller by phone and then STILL asks
# them to read back the email on their application before any interview
# question. That second step exists because caller ID proves which phone
# called, not who is holding it — a spoofed number would otherwise walk
# straight into someone else's interview.
#
# Turned off here: a candidate calling from the number on their own CV is asked
# nothing extra. Callers whose number is NOT on file are still sent down the
# IDENTIFY path and must give their email, so an unknown caller is never let
# through unverified.
VERIFY_CALLER_EMAIL=false
