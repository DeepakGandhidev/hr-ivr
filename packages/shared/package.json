{
  "name": "@pratibha/shared",
  "version": "2.0.0",
  "description": "Shared constants, types, validation and authz utilities for Pratibha",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./crypto": {
      "import": "./dist/crypto.js",
      "types": "./dist/crypto.d.ts"
    },
    "./limits": {
      "import": "./dist/limits.js",
      "types": "./dist/limits.d.ts"
    },
    "./mail-oauth": {
      "import": "./dist/mailOAuth.js",
      "types": "./dist/mailOAuth.d.ts"
    },
    "./settings-registry": {
      "import": "./dist/settingsRegistry.js",
      "types": "./dist/settingsRegistry.d.ts"
    },
    "./settings-runtime": {
      "import": "./dist/settingsRuntime.js",
      "types": "./dist/settingsRuntime.d.ts"
    },
    "./platform-mail": {
      "import": "./dist/platformMail.js",
      "types": "./dist/platformMail.d.ts"
    },
    "./mailer": {
      "import": "./dist/mailer.js",
      "types": "./dist/mailer.d.ts"
    },
    "./email-kinds": {
      "import": "./dist/emailKinds.js",
      "types": "./dist/emailKinds.d.ts"
    },
    "./whatsapp": {
      "import": "./dist/whatsapp.js",
      "types": "./dist/whatsapp.d.ts"
    },
    "./whatsapp-kinds": {
      "import": "./dist/whatsappKinds.js",
      "types": "./dist/whatsappKinds.d.ts"
    }
