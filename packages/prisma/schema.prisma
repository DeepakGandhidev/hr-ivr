// Pratibha v2 — multi-tenant hiring pipeline schema
// §4 of the BRD. Every tenant-scoped table carries tenant_id.

generator client {
  provider = "prisma-client-js"
  output   = "./src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

model Plan {
  id          String   @id @default(cuid())
  name        String   @unique
  priceInr    Int      @map("price_inr")
  limits      Json
  features    Json
  createdAt   DateTime @default(now()) @map("created_at")

  tenants     Tenant[]

  @@map("plans")
}

model PlatformUser {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  authProviderId  String?  @unique @map("auth_provider_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("platform_users")
}

// ---------------------------------------------------------------------------
// Tenancy & users
// ---------------------------------------------------------------------------

enum TenantStatus {
  trial
  active
  suspended
}

/// The company's own details, as distinct from how it sounds on a call.
///
/// `legalName` here is what goes on an invoice or a contract. The name Pratibha
/// says out loud lives on InterviewProtocol.companyName, scoped per job, and the
/// two are deliberately separate: a company hiring under a brand still invoices
/// under its registered entity.
///
/// One row per tenant, created on demand rather than at signup - an empty
/// profile and no profile mean the same thing, and the second needs no migration
/// to backfill.
model CompanyProfile {
  id              String   @id @default(cuid())
  tenantId        String   @unique @map("tenant_id")

  /// Registered entity name, for invoices and contracts.
  legalName       String?  @map("legal_name")
  /// Registered / billing address, free-form: Indian addresses do not fit
  /// fixed fields, and an invoice needs it as written.
  billingAddress  String?  @map("billing_address")
  /// State, which decides CGST+SGST versus IGST on an invoice. Held separately
  /// from the address because it is a calculation input, not decoration.
  billingState    String?  @map("billing_state")
  gstin           String?
  /// Shown on the hosted careers page.
  description     String?

  /// The logo, as a TenantAsset id. Not a URL: the file is served through a
  /// tenant-scoped route, so storing a path would invite bypassing it.
  logoAssetId     String?  @map("logo_asset_id")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logo            TenantAsset? @relation("CompanyLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)

  @@map("company_profiles")
}

enum TenantAssetKind {
  company_logo
  user_photo
}

/// A file belonging to a tenant.
///
/// Rows here are the index; the bytes live behind the storage driver
/// (`apps/web/src/lib/storage.ts`), which is local disk today and swappable.
/// Keeping an index in the database is what makes these findable for the
/// deletion flow - files written straight to disk with a path in a column are
/// exactly the ones nobody remembers to delete.
///
/// `tenantId` cascades, so deleting a tenant removes the rows; the storage
/// driver is called alongside to remove the bytes.
model TenantAsset {
  id          String          @id @default(cuid())
  tenantId    String          @map("tenant_id")
  kind        TenantAssetKind
  /// Opaque key for the storage driver. Never a browser-reachable URL.
  storageKey  String          @map("storage_key")
  contentType String          @map("content_type")
  byteSize    Int             @map("byte_size")
  uploadedBy  String?         @map("uploaded_by")
  createdAt   DateTime        @default(now()) @map("created_at")

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyLogos CompanyProfile[] @relation("CompanyLogo")
  userPhotos   User[]          @relation("UserPhoto")

  @@index([tenantId, kind])
  @@map("tenant_assets")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  /// Cancelled but still inside the paid period.
  cancelling
  /// Period over: read-only, pending deletion.
  expired
}

enum MandateStatus {
  none
  pending
  active
  failed
  revoked
}

enum InvoiceStatus {
  draft
  issued
  paid
  void
}

/// What a tenant is paying for, and where they are in the cycle.
///
/// Separate from Tenant.planId, which stays as the fast path everything else
/// already reads. This row carries the billing state that planId cannot express:
/// when the period ends, whether a cancellation is pending, and why.
model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique @map("tenant_id")
  planId             String             @map("plan_id")
  status             SubscriptionStatus @default(trialing)

  /// The billing cycle. "Days left" on the subscriptions page is the single
  /// most important number on it, and it comes from here.
  periodStart        DateTime           @map("period_start")
  periodEnd          DateTime           @map("period_end")

  /// Minutes bought on top of the plan, for this period. Spent after the plan
  /// allowance, so a top-up cannot silently expire while plan minutes remain.
  topUpMinutes       Int                @default(0) @map("top_up_minutes")

  /// Set when cancellation is requested, not when it takes effect - the
  /// customer keeps what they paid for until periodEnd.
  cancelRequestedAt  DateTime?          @map("cancel_requested_at")
  cancelReason       String?            @map("cancel_reason")
  cancelComment      String?            @map("cancel_comment")

  /// Finance's address, deliberately not a portal login: an invoice should
  /// reach the person who pays without giving them the hiring data.
  billingContactEmail String?           @map("billing_contact_email")
  /// Which billing emails that contact receives, as { key: boolean }.
  billingContactPrefs Json?             @map("billing_contact_prefs")

  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentMethods     PaymentMethod[]
  invoices           Invoice[]
  couponRedemptions  CouponRedemption[]

  @@map("subscriptions")
}

/// A stored payment instrument.
///
/// No card data of our own: `providerRef` is the gateway's token and the brand
/// and last four are display only. Nothing here is enough to charge anybody,
/// which is the point - the moment this table could, it would need PCI scope.
model PaymentMethod {
  id             String        @id @default(cuid())
  subscriptionId String        @map("subscription_id")
  /// Which gateway issued the token, so a provider switch is detectable rather
  /// than a silent mismatch.
  provider       String
  providerRef    String        @map("provider_ref")
  brand          String?
  last4          String?
  mandateStatus  MandateStatus @default(none) @map("mandate_status")
  isDefault      Boolean       @default(false) @map("is_default")
  createdAt      DateTime      @default(now()) @map("created_at")

  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, isDefault])
  @@map("payment_methods")
}

/// One issued invoice.
///
/// Seller and buyer details are SNAPSHOTTED rather than joined. An invoice is a
/// legal record of what was true when it was issued: if the customer later
/// corrects their GSTIN or we move to a different selling entity, last
/// quarter's invoice must not silently change to match.
model Invoice {
  id             String        @id @default(cuid())
  subscriptionId String        @map("subscription_id")
  /// Human-readable, gapless per financial year, e.g. PMT/2026-27/0007.
  number         String        @unique
  status         InvoiceStatus @default(issued)

  periodStart    DateTime      @map("period_start")
  periodEnd      DateTime      @map("period_end")
  issuedAt       DateTime      @default(now()) @map("issued_at")
  paidAt         DateTime?     @map("paid_at")

  /// Line items: description, hsnSac, quantity, unitPaise, amountPaise.
  lines          Json

  /// Money in paise. Integers, because floating point on money produces
  /// invoices that are off by a rupee and a CA who stops trusting them.
  subtotalPaise  Int           @map("subtotal_paise")
  discountPaise  Int           @default(0) @map("discount_paise")
  cgstPaise      Int           @default(0) @map("cgst_paise")
  sgstPaise      Int           @default(0) @map("sgst_paise")
  igstPaise      Int           @default(0) @map("igst_paise")
  totalPaise     Int           @map("total_paise")

  /// The customer's state at issue time. Decides the tax split, so it is
  /// recorded rather than recomputed.
  placeOfSupply  String        @map("place_of_supply")
  seller         Json
  buyer          Json

  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, issuedAt])
  @@map("invoices")
}

enum CouponKind {
  percent
  amount
  minutes
}

/// A redeemable code. Platform-wide, not tenant-scoped - hence no tenantId and
/// no RLS policy; redemptions are what belong to a tenant.
model Coupon {
  id           String     @id @default(cuid())
  code         String     @unique
  kind         CouponKind
  /// Percent (1-100), paise, or minutes, according to `kind`.
  value        Int
  /// Null means unlimited.
  maxRedemptions Int?     @map("max_redemptions")
  redeemedCount  Int      @default(0) @map("redeemed_count")
  expiresAt    DateTime?  @map("expires_at")
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")

  redemptions  CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id             String       @id @default(cuid())
  couponId       String       @map("coupon_id")
  subscriptionId String       @map("subscription_id")
  redeemedAt     DateTime     @default(now()) @map("redeemed_at")

  coupon         Coupon       @relation(fields: [couponId], references: [id], onDelete: Cascade)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// One tenant cannot redeem the same code twice.
  @@unique([couponId, subscriptionId])
  @@map("coupon_redemptions")
}

model Tenant {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  planId        String       @map("plan_id")
  trialEndsAt   DateTime?    @map("trial_ends_at")
  status        TenantStatus @default(trial)
  createdAt     DateTime     @default(now()) @map("created_at")

  companyProfile CompanyProfile?
  assets        TenantAsset[]
  subscription  Subscription?

  plan          Plan         @relation(fields: [planId], references: [id])
  users         User[]
  emailConnections EmailConnection[]
  jobs          Job[]
  candidates    Candidate[]
  outreachTemplates OutreachTemplate[]
  interviewProtocols InterviewProtocol[]
  usageMeters   UsageMeter[]
  auditLogs     AuditLog[]

  @@map("tenants")
}

enum UserRole {
  owner
  admin
  reviewer
  viewer
}

model User {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  email           String
  name            String?
  role            UserRole
  authProviderId  String?  @unique @map("auth_provider_id")
  createdAt       DateTime @default(now()) @map("created_at")

  // --- Personal profile ----------------------------------------------------

  /// Profile photo, as a TenantAsset id. Same reasoning as the company logo:
  /// the file is served through a tenant-scoped route, never a bare path.
  photoAssetId    String?  @map("photo_asset_id")

  /// IANA zone, e.g. "Asia/Kolkata". Timestamps are stored in UTC; this only
  /// decides how they are rendered for this person.
  timezone        String?

  /// Which emails this person receives, as { key: boolean }. Absent keys mean
  /// "on" - a notification type added later should reach people rather than be
  /// silently off for everyone who has ever saved preferences.
  notificationPrefs Json?  @map("notification_prefs")

  /// Two-factor authentication is deliberately NOT stored here. GoTrue owns it
  /// (auth.mfa_factors) and is the thing that actually gates a login; a second
  /// secret in this table could only be checked by our own screens, which an
  /// attacker with the password would simply not visit. Enrolment status is
  /// read from GoTrue rather than mirrored, so the two cannot disagree.

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  photo           TenantAsset? @relation("UserPhoto", fields: [photoAssetId], references: [id], onDelete: SetNull)
  jobsCreated     Job[]    @relation("CreatedBy")
  jobsDeleted     Job[]    @relation("DeletedBy")
  jobVersions     JobVersion[] @relation("JobVersionAuthor")
  candidateNotes  CandidateNote[] @relation("NoteAuthor")
  jobDescriptionsApproved JobDescription[] @relation("ApprovedBy")
  approvals       Approval[]
  interviewProtocolsUpdated InterviewProtocol[] @relation("UpdatedBy")
  outreachTemplates OutreachTemplate[] @relation("UpdatedBy")

  @@unique([tenantId, email])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Email ingestion
// ---------------------------------------------------------------------------

enum EmailProvider {
  gmail
  outlook
  imap
  forward_alias
}

enum EmailConnectionStatus {
  connected
  error
  revoked
}

model EmailConnection {
  id              String                  @id @default(cuid())
  tenantId        String                  @map("tenant_id")
  provider        EmailProvider
  address         String
  oauthTokenRef   String?                 @map("oauth_token_ref") // Supabase Vault reference
  status          EmailConnectionStatus   @default(connected)
  lastPollAt      DateTime?               @map("last_poll_at")
  errorDetail     String?                 @map("error_detail")
  createdAt       DateTime                @default(now()) @map("created_at")

  // --- IMAP (cPanel/webmail, Zoho, Namecheap, any host) -------------------
  imapHost        String?                 @map("imap_host")
  imapPort        Int?                    @map("imap_port")
  imapSecure      Boolean                 @default(true) @map("imap_secure")
  imapUsername    String?                 @map("imap_username")
  /// AES-256-GCM sealed mailbox password. Never a plaintext credential.
  imapSecret      String?                 @map("imap_secret")
  folder          String                  @default("INBOX")

  /// IMAP UIDs are only unique within a UIDVALIDITY generation. If the server
  /// renumbers the mailbox, UIDVALIDITY changes and lastSeenUid becomes
  /// meaningless, so both are stored and compared together before it is used.
  uidValidity     BigInt?                 @map("uid_validity")
  lastSeenUid     BigInt?                 @map("last_seen_uid")

  /// Where candidates from this mailbox are filed. With autoRoute off this is
  /// the destination; with it on this is the fallback for mail that matches no
  /// open job. Either way, null leaves the connection idle rather than
  /// guessing a destination.
  defaultJobId    String?                 @map("default_job_id")

  /// One mailbox for every open role: match each application to a job instead
  /// of filing everything against a single one.
  autoRoute       Boolean                 @default(false) @map("auto_route")

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultJob      Job?                    @relation(fields: [defaultJobId], references: [id], onDelete: SetNull)

  @@index([provider, status, lastPollAt])
  @@map("email_connections")
}

// ---------------------------------------------------------------------------
// Jobs & descriptions
// ---------------------------------------------------------------------------

enum JobStatus {
  draft
  open
  paused
  closed
}

model Job {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  slug              String
  title             String
  status            JobStatus @default(draft)
  location          String?
  salaryBand        String?  @map("salary_band")
  experienceRange   String?  @map("experience_range")
  mustHaves         Json     @map("must_haves")
  goodToHaves       Json     @map("good_to_haves")
  // §5 Stage 5 / §9: per-job override of the screening threshold. Null means
  // fall back to DEFAULT_SCREENING_THRESHOLD (70).
  screeningThreshold Int?    @map("screening_threshold")
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  /// Soft delete. A job is never removed: candidates, screenings, calls and
  /// assessment reports all hang off it, and destroying a role would take the
  /// evidence for hiring decisions with it. Every list filters on this being
  /// null; nothing hard-deletes.
  deletedAt         DateTime? @map("deleted_at")
  deletedBy         String?   @map("deleted_by")

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator           User     @relation("CreatedBy", fields: [createdBy], references: [id])
  deleter           User?    @relation("DeletedBy", fields: [deletedBy], references: [id])
  versions          JobVersion[]
  descriptions      JobDescription[]
  posts             JobPost[]
  candidates        Candidate[]
  shortlists        Shortlist[]
  callWindows       CallWindow[]
  interviewProtocols InterviewProtocol[]
  emailConnections  EmailConnection[]

  @@unique([tenantId, slug])
  @@map("jobs")
}

enum DescriptionGeneratedBy {
  ai
  human
}

model JobDescription {
  id            String                  @id @default(cuid())
  jobId         String                  @map("job_id")
  version       Int
  bodyMd        String                  @map("body_md")
  generatedBy   DescriptionGeneratedBy  @default(human) @map("generated_by")
  approvedBy    String?                 @map("approved_by")
  approvedAt    DateTime?               @map("approved_at")
  createdAt     DateTime                @default(now()) @map("created_at")

  job           Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  approver      User?                   @relation("ApprovedBy", fields: [approvedBy], references: [id])

  @@unique([jobId, version])
  @@map("job_descriptions")
}

/// A snapshot of the structured role, taken before each edit.
///
/// JobDescription already versions the JD *body*. It does not cover the fields
/// a recruiter most often needs to correct - salary band, experience range,
/// must-haves - and those are what the role is actually screened against. An
/// edit that silently rewrote them would leave no way to answer "what were we
/// screening for when we rejected this candidate".
model JobVersion {
  id                 String   @id @default(cuid())
  jobId              String   @map("job_id")
  version            Int
  title              String
  location           String?
  salaryBand         String?  @map("salary_band")
  experienceRange    String?  @map("experience_range")
  mustHaves          Json     @map("must_haves")
  goodToHaves        Json     @map("good_to_haves")
  screeningThreshold Int?     @map("screening_threshold")
  /// Why this edit was made, when the editor said.
  changeNote         String?  @map("change_note")
  createdBy          String   @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")

  job                Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  author             User     @relation("JobVersionAuthor", fields: [createdBy], references: [id])

  @@unique([jobId, version])
  @@map("job_versions")
}

enum JobPostChannel {
  careers_page
  linkedin
  naukri
  manual
}

enum JobPostStatus {
  pending
  posted
  failed
  removed
}

model JobPost {
  id                    String          @id @default(cuid())
  jobId                 String          @map("job_id")
  channel               JobPostChannel
  status                JobPostStatus   @default(pending)
  externalRef           String?         @map("external_ref")
  postedAt              DateTime?       @map("posted_at")
  includesPratibhaNumber Boolean        @default(true) @map("includes_pratibha_number")
  errorDetail           String?         @map("error_detail")
  createdAt             DateTime        @default(now()) @map("created_at")

  job                   Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_posts")
}

// ---------------------------------------------------------------------------
// Candidates & screening
// ---------------------------------------------------------------------------

/// Where a candidate stands in the pipeline.
///
/// One field, deliberately: a board view added later reads this rather than
/// deriving a second state machine from screenings, shortlist rows and reports.
///
/// The first four are reached on their own as those events happen. The last
/// three are judgements and are only ever set by a person - nothing in the
/// system infers that someone was hired.
enum CandidateStatus {
  inbox
  screened
  shortlisted
  interviewed
  advance_stage
  hired
  rejected
}

model Candidate {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  jobId             String   @map("job_id")
  name              String?
  email             String?
  phoneE164         String?  @map("phone_e164")
  cvFileRef         String?  @map("cv_file_ref")
  cvParsed          Json?    @map("cv_parsed")
  sourceEmailMsgId  String?  @unique @map("source_email_msg_id")
  parseFailed       Boolean  @default(false) @map("parse_failed")
  noPhone           Boolean  @default(false) @map("no_phone")

  /// Pipeline position. Automatic progression only moves forward and never
  /// overwrites a manual judgement - see `advanceCandidateStatus` in
  /// @pratibha/shared. Who changed it, from what and when lives in AuditLog
  /// under the `candidate.status` action, which is what the activity timeline
  /// renders.
  status            CandidateStatus @default(inbox)

  /// How this candidate reached this job: 'auto' (matched by the router),
  /// 'fallback' (matched nothing, filed in the mailbox's fallback job),
  /// 'fixed' (the mailbox files everything into one job), or 'manual' (a
  /// recruiter uploaded the CV or typed the details in). Null for rows that
  /// predate routing.
  routedBy          String?  @map("routed_by")
  /// Router score for an 'auto' match, so a confident hit is distinguishable
  /// from a marginal one when a recruiter reviews the pipeline.
  routingConfidence Int?     @map("routing_confidence")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  job               Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  screenings        Screening[]
  notes             CandidateNote[]
  shortlistItems    ShortlistItem[]
  outreachEmails    OutreachEmail[]
  interviewCalls    InterviewCall[]

  @@unique([tenantId, jobId, phoneE164])
  @@index([tenantId, phoneE164])
  @@index([tenantId, jobId, email])
  // The candidates list filters and groups by status within a job.
  @@index([tenantId, jobId, status])
  @@map("candidates")
}

/// Free-text notes any team member can leave on a candidate.
///
/// Edit and delete are the author's alone - enforced in the API, not just
/// hidden in the UI. A note is someone's own judgement of a person, and letting
/// a colleague quietly rewrite it changes the record of who thought what.
model CandidateNote {
  id          String    @id @default(cuid())
  candidateId String    @map("candidate_id")
  authorId    String    @map("author_id")
  body        String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  author      User      @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([candidateId, createdAt])
  @@map("candidate_notes")
}

enum ScreeningVerdict {
  shortlist
  archive
}

model Screening {
  id                String            @id @default(cuid())
  candidateId       String            @map("candidate_id")
  score             Int
  matchedMustHaves  Json              @map("matched_must_haves")
  gaps              Json
  model             String
  tokensIn          Int               @map("tokens_in")
  tokensOut         Int               @map("tokens_out")
  costUsd           Float             @map("cost_usd")
  verdict           ScreeningVerdict
  reasonSummary     String            @map("reason_summary")
  failed            Boolean           @default(false)
  createdAt         DateTime          @default(now()) @map("created_at")

  candidate         Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("screenings")
}

// ---------------------------------------------------------------------------
// Shortlists & approvals (G2 gate)
// ---------------------------------------------------------------------------

enum ShortlistStatus {
  draft
  awaiting_approval
  approved
  rejected
}

model Shortlist {
  id          String          @id @default(cuid())
  jobId       String          @map("job_id")
  status      ShortlistStatus @default(draft)
  createdAt   DateTime        @default(now()) @map("created_at")

  job         Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  items       ShortlistItem[]
  approvals   Approval[]

  @@map("shortlists")
}

enum ShortlistItemFinalState {
  approved
  removed
}

model ShortlistItem {
  id          String                   @id @default(cuid())
  shortlistId String                   @map("shortlist_id")
  candidateId String                   @map("candidate_id")
  addedBy     String                   @map("added_by") // 'ai' or user_id
  removedBy   String?                  @map("removed_by")
  finalState  ShortlistItemFinalState? @map("final_state")
  createdAt   DateTime                 @default(now()) @map("created_at")

  shortlist   Shortlist                @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  candidate   Candidate                @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([shortlistId, candidateId])
  @@map("shortlist_items")
}

model Approval {
  id            String    @id @default(cuid())
  shortlistId   String    @map("shortlist_id")
  approvedBy    String    @map("approved_by")
  approvedAt    DateTime  @default(now()) @map("approved_at")
  snapshot      Json

  shortlist     Shortlist @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  approver      User      @relation(fields: [approvedBy], references: [id])
  outreachEmails OutreachEmail[]

  @@map("approvals")
}

// ---------------------------------------------------------------------------
// Outreach
// ---------------------------------------------------------------------------

enum OutreachTemplateType {
  interview_invite
  rejection
  reminder
}

enum OutreachEmailStatus {
  sent
  bounced
  failed
}

model OutreachTemplate {
  id          String                  @id @default(cuid())
  tenantId    String                  @map("tenant_id")
  type        OutreachTemplateType
  subject     String
  bodyMd      String                  @map("body_md")
  isDefault   Boolean                 @default(false) @map("is_default")
  updatedBy   String?                 @map("updated_by")
  createdAt   DateTime                @default(now()) @map("created_at")

  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updater     User?                   @relation("UpdatedBy", fields: [updatedBy], references: [id])
  emails      OutreachEmail[]

  @@map("outreach_templates")
}

model OutreachEmail {
  id            String                @id @default(cuid())
  candidateId   String                @map("candidate_id")
  templateId    String                @map("template_id")
  renderedBody  String                @map("rendered_body")
  sentAt        DateTime?             @map("sent_at")
  status        OutreachEmailStatus?
  approvalId    String                @map("approval_id")
  createdAt     DateTime              @default(now()) @map("created_at")

  candidate     Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  template      OutreachTemplate      @relation(fields: [templateId], references: [id])
  approval      Approval              @relation(fields: [approvalId], references: [id])

  @@index([approvalId, candidateId])
  @@map("outreach_emails")
}

// ---------------------------------------------------------------------------
// Call windows
// ---------------------------------------------------------------------------

model CallWindow {
  id          String   @id @default(cuid())
  jobId       String   @map("job_id")
  timezone    String
  days        Json     // array of weekday numbers 0-6
  startTime   String   @map("start_time") // HH:mm
  endTime     String   @map("end_time")   // HH:mm
  createdAt   DateTime @default(now()) @map("created_at")

  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("call_windows")
}

// ---------------------------------------------------------------------------
// Interview protocols & calls
// ---------------------------------------------------------------------------

enum InterviewDifficulty {
  easy
  moderate
  hard
  expert
}

model InterviewProtocol {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  jobId             String?   @map("job_id") // null = tenant default
  instructionText   String    @map("instruction_text")

  /// Wall-clock budget for the call. Enforced by the agent, not just requested
  /// in the prompt: a model asked to be brief is not a guarantee.
  durationMinutes   Int                 @default(10) @map("duration_minutes")
  difficulty        InterviewDifficulty @default(moderate)
  minQuestions      Int                 @default(6) @map("min_questions")
  maxQuestions      Int                 @default(10) @map("max_questions")
  /// Optional list of topics to bias questions towards.
  focusAreas        Json?               @map("focus_areas")
  /// What the agent calls itself, and the company it says it represents.
  /// Null falls back to the tenant name.
  agentName         String?             @map("agent_name")
  companyName       String?             @map("company_name")
  version           Int
  updatedBy         String?   @map("updated_by")
  createdAt         DateTime  @default(now()) @map("created_at")

  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  job               Job?      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  updater           User?     @relation("UpdatedBy", fields: [updatedBy], references: [id])

  @@unique([tenantId, jobId])
  @@map("interview_protocols")
}

enum InterviewLanguage {
  en
  hi
  hinglish
}

enum InterviewCallStatus {
  completed
  dropped
  no_show
  unknown_caller
  out_of_window
  declined_consent
}

model InterviewCall {
  id              String                @id @default(cuid())
  candidateId     String                @map("candidate_id")
  callerNumber    String                @map("caller_number")
  recognised      Boolean               @default(false)
  startedAt       DateTime              @default(now()) @map("started_at")
  endedAt         DateTime?             @map("ended_at")
  language        InterviewLanguage?
  status          InterviewCallStatus?
  recordingRef    String?               @map("recording_ref")
  transcriptRef   String?               @map("transcript_ref")

  /// The conversation itself: an ordered array of
  /// `{ speaker: 'pratibha' | 'candidate', text, atMs }`.
  ///
  /// Held here rather than behind `transcriptRef` because nothing ever wrote
  /// that ref - it points at a durable copy in ProMonkey OS the worker has no
  /// code to send, so every call in production had a null transcript and the
  /// portal had nothing to show. On the call row it inherits the tenant
  /// isolation and the delete cascade the candidate's record already has.
  transcript      Json?
  /// When the first question was put. Billing runs from here, not from when
  /// the phone was answered: greeting, disclosure, identity and consent are
  /// deliberately not charged for, and that is what customers are told.
  firstQuestionAt DateTime?             @map("first_question_at")
  /// What this call was billed, in whole minutes. Stored rather than derived so
  /// an invoice can be reconciled against the call that produced it, even if
  /// the rounding rule changes later.
  billableMinutes Int?                  @map("billable_minutes")

  telephonyCost   Float?                @map("telephony_cost")
  llmCostUsd      Float?                @map("llm_cost_usd")
  ttsCostUsd      Float?                @map("tts_cost_usd")
  sttCostUsd      Float?                @map("stt_cost_usd")
  createdAt       DateTime              @default(now()) @map("created_at")

  candidate       Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assessmentReport AssessmentReport?

  @@map("interview_calls")
}

enum Recommendation {
  strong_yes
  yes
  maybe
  no
}

model AssessmentReport {
  id                String            @id @default(cuid())
  interviewCallId   String            @unique @map("interview_call_id")
  overallScore      Float             @map("overall_score")
  recommendation    Recommendation
  dimensions        Json
  strengths         String[]
  concerns          String[]
  notableQuotes     Json              @map("notable_quotes")
  generatedAt       DateTime          @default(now()) @map("generated_at")

  // --- The report as the recruiter reads it -------------------------------
  //
  // Two scores, deliberately separate and allowed to disagree. `interviewScore`
  // is how the conversation went; `recommendationScore` is the verdict on the
  // whole picture - JD, CV screening and interview together. Somebody can
  // interview well and screen badly, and collapsing that into one number is
  // exactly the information a hiring manager needs and would lose.

  /// Section 1: how the interview itself went, 0-10.
  interviewScore          Float?   @map("interview_score")
  /// Why that score, written out. A number with no argument cannot be checked.
  interviewScoreReasoning String?  @map("interview_score_reasoning")

  /// Section 2: question-and-answer pairs, derived from the stored transcript
  /// rather than asked of the model - the conversation is already on record,
  /// and regenerating it invites invented questions.
  questionAnswers         Json?    @map("question_answers")

  /// Section 3: how this candidate fits this role's actual requirements.
  jdFitSummary            String?  @map("jd_fit_summary")

  /// Section 4: the overall verdict, 0-10, across screening and interview.
  recommendationScore     Float?   @map("recommendation_score")
  recommendationVerdict   String?  @map("recommendation_verdict")

  interviewCall     InterviewCall     @relation(fields: [interviewCallId], references: [id], onDelete: Cascade)

  @@map("assessment_reports")
}

// ---------------------------------------------------------------------------
// Billing & metering
// ---------------------------------------------------------------------------

model UsageMeter {
  id                  String   @id @default(cuid())
  tenantId            String   @map("tenant_id")
  period              String   // YYYY-MM
  /// Retained so historical periods still read correctly, and because the UI
  /// shows an approximate interview count beside the minutes. Not the quota.
  interviewsUsed      Int      @default(0) @map("interviews_used")
  /// The quota that is actually enforced and billed. Pricing is per minute.
  interviewMinutesUsed Int     @default(0) @map("interview_minutes_used")
  screeningsUsed      Int      @default(0) @map("screenings_used")
  overageInterviews   Int      @default(0) @map("overage_interviews")
  overageMinutes      Int      @default(0) @map("overage_minutes")
  overageScreenings   Int      @default(0) @map("overage_screenings")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, period])
  @@map("usage_meters")
}

// ---------------------------------------------------------------------------
// Audit & prompt templates
// ---------------------------------------------------------------------------

enum PromptTemplateKey {
  jd_generation
  cv_screening
  interviewer_system
  report_generation
}

model PromptTemplate {
  id        String            @id @default(cuid())
  key       PromptTemplateKey
  version   Int
  body      String
  active    Boolean           @default(false)
  createdAt DateTime          @default(now()) @map("created_at")

  @@unique([key, version])
  @@index([key, active])
  @@map("prompt_templates")
}

model AuditLog {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  actor     String    // user_id | system | platform_admin
  action    String
  entity    String
  entityId  String    @map("entity_id")
  before    Json?
  after     Json?
  reason    String?
  createdAt DateTime  @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([action, entity])
  @@map("audit_logs")
}
