# Pratibha - inbound hiring agent. Copy to .env and fill in.
# There is no outbound anything in here. See section 3.1.

PORT=8091
PUBLIC_BASE_URL=https://hiring.promonkey.tech
PUBLIC_WS_URL=wss://hiring.promonkey.tech/pratibha/stream

# --- Plivo -------------------------------------------------------------------
# The auth token verifies inbound webhook signatures. There is deliberately no
# PLIVO_AUTH_ID: the REST API needs both, so without it this service cannot
# place a call even if someone later adds code that tries.
PLIVO_AUTH_TOKEN=
PRATIBHA_NUMBER=+918031705255
# Set false only to debug a signature mismatch, and never in production.
PLIVO_VERIFY_SIGNATURE=true

# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=
# On the call. Latency is the binding constraint (4.2), so this is a fast model.
ANTHROPIC_MODEL=claude-haiku-4-5
# After the call. No latency budget, and a human acts on the output.
ANTHROPIC_ANALYSIS_MODEL=claude-opus-5

# --- Sarvam (speech) ---------------------------------------------------------
# India-hosted, and handles Indian-accented English with Hindi code-switching,
# which 4.1 requires. Keeping speech in-country also matters for 3.6.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3-realtime
# auto lets a candidate slip into Hindi mid-answer. If it proves noisy, try
# en-IN with SARVAM_STT_MODE=codemix.
SARVAM_STT_LANGUAGE=auto
SARVAM_STT_MODE=transcribe
SARVAM_STT_STREAM_TYPE=fast
# Interview answers have long thinking pauses. Sarvam's 500ms default cuts
# people off mid-thought.
SARVAM_STT_SILENCE_MS=800
# Speakers are model-specific - a name from another version is a 422, not a fallback.
# Female v3 voices: ritu, priya, neha, pooja, simran, kavya, ishita, shreya.
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=ritu
SARVAM_TTS_LANGUAGE=en-IN
# bulbul:v3 emits 22050 Hz and ignores output_audio_sample_rate. Its mulaw is
# 22050 Hz as well, and tts.js passes mulaw through untranscoded - so it would
# play at a third speed. linear16 routes through pcmToMulaw8k, which resamples.
SARVAM_TTS_CODEC=linear16
SARVAM_TTS_SOURCE_RATE=22050

# --- Voice vendor ------------------------------------------------------------
# sarvam or elevenlabs. Only the chosen one's settings are read, and only its
# credentials are required at boot. Recognition stays on Sarvam either way.
TTS_PROVIDER=sarvam

# --- ElevenLabs (only when TTS_PROVIDER=elevenlabs) ---------------------------
ELEVENLABS_API_KEY=
# No default - paste an id from the ElevenLabs voice library. An Indian-English
# voice matters as much here as the Sarvam speaker does.
ELEVENLABS_VOICE_ID=
# flash is the low-latency model; eleven_turbo_v2_5 sounds better and costs
# roughly 150ms more before the first syllable reaches the caller.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ulaw_8000 is exactly what Plivo wants, so nothing is transcoded. pcm_<rate>
# works too and routes through pcmToMulaw8k. The mp3 formats are refused at
# boot - there is no decoder for them here.
ELEVENLABS_OUTPUT_FORMAT=ulaw_8000
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_SPEED=1.0

# --- Barge-in VAD ------------------------------------------------------------
# Tune against real calls. Too sensitive and line noise cuts Pratibha off
# mid-question; too dull and she talks over the candidate.
VAD_RATIO=3.0
VAD_FLOOR=0.010
VAD_SPEECH_FRAMES=3
VAD_SILENCE_FRAMES=25

# --- ProMonkey OS ------------------------------------------------------------
OS_API_BASE=https://os.promonkey.tech
OS_SERVICE_TOKEN=
OS_HMAC_SECRET=

# --- Operating hours (4.3, pending confirmation) -----------------------------
# 0=Sun, 1=Mon ... 6=Sat. Hours are 0-24, so 0 to 24 is the whole day.
# Set OPERATING_HOURS_LABEL only to override the spoken wording.
OPERATING_TIMEZONE=Asia/Kolkata
OPERATING_DAYS=1,2,3,4,5
OPERATING_START_HOUR=0
OPERATING_END_HOUR=24

# 4.4 - each call holds an STT socket, a TTS socket and a model session.
MAX_CONCURRENT_CALLS=10

# --- Local development -------------------------------------------------------
# Hardcoded invite/candidate data and no OS API calls.
MOCK_MODE=true
LOG_LEVEL=info
# Candidate transcripts are sensitive personal data (3.6). The durable copy
# lives in ProMonkey OS, encrypted and access-logged. Leave this unset in
# production; set it only to debug, and delete the directory afterwards.
# TRANSCRIPT_DIR=transcripts
